"VertexlitGeneric"
{
	"$basetexture" "monsoon/linux55/body"
	"$bumpmap" "monsoon/linux55/body_n"
	"$model" "1"
$nocull "1" 
    "$envmap"                   "monsoon/linux55/cube"


	"$ambientocclusion"         "1"
	"$halflambert"              "1"

    "$phong"                    "1"
    "$phongboost"               ".3.25"
    "$phongexponent"            "13"
	"$phongfresnelranges"	"[0.5 6 10]"
    "$phongalbedotint"          "1"
    "$envmaptint"               "[.0035 .0035 .0035]"
	"$envmapsaturation" "0.02"
	"$envmapcontrast" "0.01"
 	"$envmapFresnel" "1"

    "$normalmapalphaenvmapmask" "1"
    "$blendtintbybasealpha"     "1"
}




