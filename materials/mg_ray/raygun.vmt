"VertexLitGeneric" {
	"$basetexture" "mg_ray/raygun"
	"$bumpmap" "mg_ray/raygun_n"

	"$nocull" "1"
	"$color2" "[ 2 2 2 ]"  

	"$phong" "1"
	"$phongexponent" "55"
	"$phongboost" "24"
	"$phongfresnelranges" "[ .4 .8 2.5 ]"

	"$normalmapalphaenvmapmask" "1"
	"$envmap" "env_cubemap"
	"$envmaptint" "[ 1 1 1 ]"
}
