"VertexlitGeneric"
{
	"$basetexture" "mgr/linux55/knife"
	"$bumpmap" "mgr/linux55/knife_n"
	"$nocull" 1
	"$model" "1"


    "$envmap"                   "monsoon/linux55/cube"
//$nodecal "1" 

	"$ambientocclusion"         "1"
	"$halflambert"              "1"

    "$phong"                    "1"
    "$phongboost"               ".3.25"
    "$phongexponent"            "13"
	"$phongfresnelranges"	"[0.5 6 10]"
    "$phongalbedotint"          "1"
    "$envmaptint"               "[.005 .005 .005]"
	"$envmapsaturation" "0.02"
	"$envmapcontrast" "0.01"
 	"$envmapFresnel" "1"

    "$normalmapalphaenvmapmask" "1"
    "$blendtintbybasealpha"     "1"
}




