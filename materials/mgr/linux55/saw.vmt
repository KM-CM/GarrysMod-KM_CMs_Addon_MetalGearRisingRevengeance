"VertexlitGeneric"
{
	"$basetexture" "mgr/linux55/saw"
	"$bumpmap" "mgr/linux55/saw_n"
	"$alphatest" 1
	"$nocull" 1
	"$model" "1"
//$nodecal "1" 

    "$phong"                    "1"
    "$phongboost"               ".3.25"
    "$phongexponent"            "13"
	"$phongfresnelranges"	"[0.5 6 10]"
    "$phongalbedotint"          "1"
Proxies
{
	TextureScroll
	{
		texturescrollvar $basetextureTransform
		texturescrollrate 15
		texturescrollangle 0
	}
}   
}



