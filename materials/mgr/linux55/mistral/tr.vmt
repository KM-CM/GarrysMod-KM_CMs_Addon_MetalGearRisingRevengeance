"UnlitGeneric"
{
	"$basetexture" "mgr/linux55/ray/tr"
	"$alphatest" 1
	"$nodecal" 1
	"$translucent" 1
	"$nocull" "1"	
	"$additive" "1"
	"$model" "1"
	"$no_fullbright" 1

	"Proxies"
	{

		"TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" .025
			"texturescrollangle" -90
		}


	}

}