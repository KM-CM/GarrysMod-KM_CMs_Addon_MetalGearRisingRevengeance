"VertexlitGeneric"
{
	"$basetexture" "mgr/linux55/spine"
	"$bumpmap" "mgr/linux55/spine_n"
	"$model" "1"

	"$basetexturealphaenvmapmask" 1
	"$envmap" "env_cubemap"
	"$envmaptint" "[ .005 .005 .007 ]"
	"$envmapsaturation" ".01"
	"$envmapcontrast" "0.1"
 	"$envmapFresnel" "0"

	"$phong" "1"
	"$phongexponent" 20
	"$phongboost" "1.5"
	"$phongfresnelranges"	"[ .53 .72 20]"
	"$PhongAlbedoTint" "1"

	"$rimlight" "1"						
	"$rimlightexponent" "255"				
	"$rimlightboost" "1"
	"$rimmask" "1"
$halflambert 1
$nocull 1
}

