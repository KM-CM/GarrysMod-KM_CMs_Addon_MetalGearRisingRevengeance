"VertexlitGeneric"
{
	"$basetexture" "mgr/linux55/raptor/body"
	"$bumpmap" "mgr/linux55/raptor/body_n"
    "$envmap"                   "env_cubemap"
//$nodecal "1" 

	"$ambientocclusion"         "1"
	"$halflambert"              "1"

	"$phong" "1"
	"$phongexponent" "10"
	"$phongboost" "1"
$phongfresnelranges "[1.3 .6 1]"

    "$phongalbedotint"          "1"
    "$envmaptint"               "[.005 .005 .005]"
	"$envmapsaturation" "0.02"
	"$envmapcontrast" "0.01"
 	"$envmapFresnel" "1"

    "$normalmapalphaenvmapmask" "1"
    "$blendtintbybasealpha"     "1"
}
