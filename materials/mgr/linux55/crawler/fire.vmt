"VertexlitGeneric"
{
	"$basetexture" "mgr/linux55/crawler/fire"
	"$bumpmap" "mgr/linux55/crawler/fire_n"
	"$nocull" 1
	"$model" "1"
//$nodecal "1" 

    "$envmap"                   "env_cubemap"


	"$ambientocclusion"         "1"
	"$halflambert"              "1"

	"$phong" "1"
	"$phongexponent" "70"
	"$phongboost" ".4"
$phongfresnelranges "[1.3 .6 1]"
"$rimlight" "1"
"$rimlightexponent" "20"	
"$rimlightboost" ".5"
    "$phongalbedotint"          "1"
    "$envmaptint"               "[.005 .005 .005]"
	"$envmapsaturation" "0.02"
	"$envmapcontrast" "0.01"
 	"$envmapFresnel" "1"

    "$normalmapalphaenvmapmask" "1"
    "$blendtintbybasealpha"     "1"
}

