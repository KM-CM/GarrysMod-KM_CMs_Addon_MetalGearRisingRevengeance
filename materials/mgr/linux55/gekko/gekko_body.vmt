"VertexLitGeneric" {
	"$basetexture" "mgr/linux55/gekko/gekko_body"
	"$bumpmap" "mgr/linux55/gekko/body_n"

	"$emissiveBlendEnabled" "1"
	"$emissiveBlendTexture" "dev/null" 
	"$emissiveBlendBaseTexture" "mgr/linux55/gekko/eye"
	"$emissiveBlendFlowTexture" "dev/null"
	"$emissiveBlendTint" "[ 1 1 1 ]"
	"$emissiveBlendStrength" "2"
	"$emissiveBlendScrollVector" "[1]"

	"$phong" "1"
	"$phongexponent" "85"
	"$phongboost" "18"
	"$phongfresnelranges" "[ .3 .65 1 ]"
	"$phongalbedotint" "1"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .2 .22 .25 ]"
	"$envmapfresnel" "1"
}
