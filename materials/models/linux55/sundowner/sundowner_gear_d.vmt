"VertexLitGeneric"
{
	"$basetexture" "models/linux55/sundowner/Sundowner_Gear_D"
	"$bumpmap" "models/linux55/sundowner/Sundowner_Gear_n"
	"$model" "1"

	"$basetexturealphaenvmapmask" 1
	"$envmap" "env_cubemap"
	"$envmaptint" "[ .0005 .0005 .0005 ]"
	"$envmapsaturation" ".01"
	"$envmapcontrast" "0.1"
 	"$envmapFresnel" "0"

	"$phong" "1"
//	"$phongexponenttexture" "models\ninja/talime2\PTY_Tali_Body_specb_1024"
	"$phongexponent" 20
	"$phongboost" "1.5"
	"$phongfresnelranges"	"[ .53 .72 20]"
//	"$PhongAlbedoTint" "1"


//	"$rimlight" "1"						
	"$rimlightexponent" "255"				
	"$rimlightboost" ".3"
	"$rimmask" "1"
$halflambert 1
$detail   "models/linux55/sundowner/glow"
        
$detailscale 1        // scales the detail texture to same size as diffuse texture.
  
$detailblendmode 5    // 6 also works. 1 can be used if both are unavailable 
                      // (such as on LightmappedGeneric), although it will still 
                      // be affected by lighting.
$nocull 1
}